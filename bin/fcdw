#!/bin/bash
# fcdw — 从 ftree-widget 选中目录跳转
target_file="$HOME/.ftree_cd_target"
if [ ! -f "$target_file" ]; then
    echo -e "\033[1;33m⚠ 还没有选过目录\033[0m"
    echo "  先在 ftree-widget 中点「确认跳转」"
    exit 1
fi
target=$(cat "$target_file" 2>/dev/null)
if [ -z "$target" ] || [ ! -d "$target" ]; then
    echo -e "\033[1;33m⚠ 目标目录不存在或已删除: $target\033[0m"
    exit 1
fi
cd "$target"
echo -e "\033[1;32m📍 → $target\033[0m"
ls --color=auto
